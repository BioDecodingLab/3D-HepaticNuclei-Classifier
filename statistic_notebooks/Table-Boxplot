        "print(friedman_csv_path)\n",
        "print(ranks_csv_path)\n",
        "print(posthoc_csv_path)\n",
        "\n",
        "print(\"\\nBest experiment by Friedman average rank:\")\n",
        "print(best_experiment)\n",
        "\n",
        "print(\"\\nFriedman results:\")\n",
        "display(friedman_results)\n",
        "\n",
        "print(\"\\nAverage ranks:\")\n",
        "display(avg_ranks_df)\n",
        "\n",
        "print(\"\\nPost hoc Wilcoxon + Holm:\")\n",
        "display(posthoc_df)\n",
        "\n",
        "print(\"\\nDONE.\")\n",
        "print(\"Final output folder:\", FINAL_OUTPUT_DIR)\n",
