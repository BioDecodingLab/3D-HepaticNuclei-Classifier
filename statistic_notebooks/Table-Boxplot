        "avg_ranks_df.to_csv(\n",
        "    ranks_csv_path,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "posthoc_df.to_csv(\n",
        "    posthoc_csv_path,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
