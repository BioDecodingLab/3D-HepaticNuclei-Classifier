        "import json\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. CONFIGURATION\n",
        "# ============================================================\n",
        "\n",
        "RESULTS_ROOT = \"/content/drive/MyDrive/Paper/results 1/results/direct_patch_classification/resnet3d_18\"\n",
        "\n",
        "FINAL_OUTPUT_DIR = \"/content/drive/MyDrive/Paper/results 1/results/Resultado_final_resnet\"\n",
        "\n",
        "CSV_OUTPUT_DIR = os.path.join(FINAL_OUTPUT_DIR, \"csv_tables\")\n",
        "PLOTS_OUTPUT_DIR = os.path.join(FINAL_OUTPUT_DIR, \"boxplots_svg\")\n",
        "\n",
        "os.makedirs(FINAL_OUTPUT_DIR, exist_ok=True)\n",
        "os.makedirs(CSV_OUTPUT_DIR, exist_ok=True)\n",
        "os.makedirs(PLOTS_OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "\n",
        "MODEL_KEY = \"resnet3d_18\"\n",
        "MODEL_NAME = \"ResNet3D-18\"\n",
        "EXPERIMENT_LABEL = \"ResNet3D-18\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. METRICS TO EXTRACT\n",
        "# ============================================================\n",
        "\n",
        "TARGET_METRICS = [\n",
        "    \"accuracy\",\n",
        "    \"precision_weighted\",\n",
        "    \"recall_weighted\",\n",
        "    \"f1_weighted\",\n",
        "    \"precision_macro\",\n",
        "    \"recall_macro\",\n",
        "    \"f1_macro\",\n",
        "    \"balanced_accuracy\"\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. BOXPLOT SETTINGS\n",
        "# ============================================================\n",
        "\n",
        "BOXPLOT_METRICS = {\n",
        "    \"f1_macro\": {\n",
        "        \"ylabel\": \"Macro F1 score per fold\",\n",
        "        \"title\": \"Test Macro F1 Score - ResNet3D-18\",\n",
        "        \"filename\": \"resnet3d_18_f1_macro_boxplot_0_4_0_7.svg\",\n",
        "        \"ylim\": (0.4, 1)\n",
        "    },\n",
        "    \"f1_weighted\": {\n",
        "        \"ylabel\": \"Weighted F1 score per fold\",\n",
        "        \"title\": \"Test Weighted F1 Score - ResNet3D-18\",\n",
        "        \"filename\": \"resnet3d_18_f1_weighted_boxplot_0_4_1_0.svg\",\n",
        "        \"ylim\": (0.4, 1.0)\n",
        "    },\n",
        "    \"balanced_accuracy\": {\n",
        "        \"ylabel\": \"Balanced accuracy per fold\",\n",
        "        \"title\": \"Test Balanced Accuracy - ResNet3D-18\",\n",
        "        \"filename\": \"resnet3d_18_balanced_accuracy_boxplot_0_4_0_7.svg\",\n",
        "        \"ylim\": (0.4, 1)\n",
        "    }\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. HELPER FUNCTIONS\n",
        "# ============================================================\n",
        "\n",
        "def normalize_text(x):\n",
        "    x = str(x).strip().lower()\n",
        "    x = x.replace(\"-\", \"_\")\n",
        "    x = x.replace(\" \", \"_\")\n",
        "    return x\n",
        "\n",
        "\n",
        "def flatten_json(d, parent_key=\"\", sep=\"_\"):\n",
        "    items = {}\n",
        "\n",
        "    if isinstance(d, dict):\n",
        "        for k, v in d.items():\n",
        "            new_key = f\"{parent_key}{sep}{k}\" if parent_key else str(k)\n",
        "            items.update(flatten_json(v, new_key, sep=sep))\n",
        "\n",
        "    elif isinstance(d, list):\n",
        "        for i, v in enumerate(d):\n",
        "            new_key = f\"{parent_key}{sep}{i}\" if parent_key else str(i)\n",
        "            items.update(flatten_json(v, new_key, sep=sep))\n",
        "\n",
        "    else:\n",
        "        items[parent_key] = d\n",
        "\n",
        "    return items\n",
        "\n",
        "\n",
        "def find_metric_value(flat_data, metric_name):\n",
        "    metric_norm = normalize_text(metric_name)\n",
        "\n",
        "    normalized_data = {\n",
        "        normalize_text(k): v\n",
        "        for k, v in flat_data.items()\n",
        "    }\n",
        "\n",
        "    possible_names = [\n",
        "        f\"test_{metric_norm}\",\n",
        "        f\"test_metrics_{metric_norm}\",\n",
        "        f\"metrics_test_{metric_norm}\",\n",
        "        f\"summary_test_{metric_norm}\",\n",
        "        metric_norm,\n",
        "        f\"metrics_{metric_norm}\",\n",
        "        f\"summary_{metric_norm}\"\n",
        "    ]\n",
        "\n",
        "    for name in possible_names:\n",
        "        if name in normalized_data:\n",
        "            return normalized_data[name]\n",
        "\n",
        "    for k, v in normalized_data.items():\n",
        "        if k.endswith(f\"test_{metric_norm}\"):\n",
        "            return v\n",
        "\n",
        "    for k, v in normalized_data.items():\n",
        "        if k.endswith(metric_norm):\n",
        "            return v\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. EXTRACT METRICS FROM fold_summary.json FILES\n",
        "# ============================================================\n",
        "\n",
        "rows = []\n",
        "\n",
        "for folder_name in sorted(os.listdir(RESULTS_ROOT)):\n",
        "    folder_path = os.path.join(RESULTS_ROOT, folder_name)\n",
        "\n",
        "    if not os.path.isdir(folder_path):\n",
        "        continue\n",
        "\n",
        "    if not re.match(r\"img_\\d+$\", folder_name.lower()):\n",
        "        continue\n",
        "\n",
        "    fold_match = re.search(r\"(\\d+)$\", folder_name)\n",
        "    fold_id = int(fold_match.group(1)) if fold_match else None\n",
        "\n",
        "    json_path = os.path.join(folder_path, \"fold_summary.json\")\n",
        "\n",
        "    if not os.path.exists(json_path):\n",
        "        print(f\"[WARNING] fold_summary.json not found in: {folder_path}\")\n",
        "        continue\n",
        "\n",
        "    try:\n",
        "        with open(json_path, \"r\", encoding=\"utf-8\") as f:\n",
        "            data = json.load(f)\n",
        "\n",
        "        flat_data = flatten_json(data)\n",
        "\n",
        "        row = {\n",
        "            \"source_folder\": folder_name,\n",
        "            \"model_key\": MODEL_KEY,\n",
        "            \"model\": MODEL_NAME,\n",
        "            \"experiment_label\": EXPERIMENT_LABEL,\n",
        "            \"augmentation\": \"direct_patch\",\n",
        "            \"fold\": fold_id,\n",
        "            \"split\": \"Test\",\n",
        "            \"metrics_file\": json_path\n",
        "        }\n",
        "\n",
        "        for metric in TARGET_METRICS:\n",
        "            row[metric] = find_metric_value(flat_data, metric)\n",
        "\n",
        "        rows.append(row)\n",
        "\n",
        "        print(f\"[OK] {folder_name} | fold {fold_id}\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"[ERROR] {json_path}: {e}\")\n",
        "\n",
        "\n",
        "summary_df = pd.DataFrame(rows)\n",
        "\n",
        "if summary_df.empty:\n",
        "    raise ValueError(\"No data extracted. Check the folder path or JSON structure.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. CLEAN DATA\n",
        "# ============================================================\n",
        "\n",
        "summary_df[\"fold\"] = pd.to_numeric(summary_df[\"fold\"], errors=\"coerce\")\n",
        "\n",
        "for col in TARGET_METRICS:\n",
        "    summary_df[col] = pd.to_numeric(summary_df[col], errors=\"coerce\")\n",
        "\n",
        "summary_df = summary_df.sort_values(\"fold\").reset_index(drop=True)\n",
        "\n",
        "print(\"\\nExtracted table:\")\n",
        "display(summary_df)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. SAVE FULL FOLD-LEVEL CSV\n",
        "# ============================================================\n",
        "\n",
        "full_csv_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    \"resnet3d_18_test_metrics_by_fold.csv\"\n",
        ")\n",
