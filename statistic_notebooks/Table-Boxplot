        "\n",
        "# ============================================================\n",
        "# 11. CREATE BOXPLOTS SVG\n",
        "# ============================================================\n",
        "\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "\n",
        "def make_boxplot(data, y_col, y_label, title, output_name, ylim):\n",
        "    plot_df = data[[\"experiment_label\", y_col]].dropna().copy()\n",
        "\n",
        "    if plot_df.empty:\n",
        "        print(f\"[WARNING] No data available for {y_col}. Skipping this boxplot.\")\n",
        "        return\n",
        "\n",
        "    print(f\"\\nPlotting: {y_col}\")\n",
        "    print(\"N:\", len(plot_df))\n",
        "    print(\"Min:\", plot_df[y_col].min())\n",
        "    print(\"Max:\", plot_df[y_col].max())\n",
        "    print(\"Y limit:\", ylim)\n",
        "\n",
        "    plt.figure(figsize=(7, 7))\n",
        "\n",
        "    ax = sns.boxplot(\n",
        "        data=plot_df,\n",
        "        x=\"experiment_label\",\n",
        "        y=y_col,\n",
        "        order=[EXPERIMENT_LABEL],\n",
        "        width=0.45,\n",
        "        showcaps=True,\n",
        "        showfliers=False,\n",
        "        boxprops=dict(\n",
        "            facecolor=\"#cfe8ff\",\n",
        "            edgecolor=\"#1f4e79\",\n",
        "            linewidth=1.8\n",
        "        ),\n",
        "        whiskerprops=dict(\n",
        "            color=\"#1f4e79\",\n",
        "            linewidth=1.8\n",
        "        ),\n",
        "        capprops=dict(\n",
        "            color=\"#1f4e79\",\n",
        "            linewidth=1.8\n",
        "        ),\n",
        "        medianprops=dict(\n",
        "            color=\"#08306b\",\n",
        "            linewidth=2.5\n",
        "        )\n",
        "    )\n",
        "\n",
        "    sns.stripplot(\n",
        "        data=plot_df,\n",
        "        x=\"experiment_label\",\n",
        "        y=y_col,\n",
        "        order=[EXPERIMENT_LABEL],\n",
        "        color=\"#0b3d91\",\n",
        "        size=6,\n",
        "        alpha=0.75,\n",
        "        jitter=0.10,\n",
        "        ax=ax\n",
        "    )\n",
        "\n",
        "    ax.set_xlabel(\"Model\", fontsize=13, fontweight=\"bold\")\n",
        "    ax.set_ylabel(y_label, fontsize=13, fontweight=\"bold\")\n",
        "    ax.set_title(title, fontsize=15, fontweight=\"bold\", pad=14)\n",
        "\n",
        "    ax.set_ylim(ylim[0], ylim[1])\n",
        "\n",
        "    plt.xticks(rotation=0, fontsize=11)\n",
        "    plt.yticks(fontsize=10)\n",
        "\n",
        "    ax.grid(axis=\"y\", linestyle=\"--\", alpha=0.25)\n",
        "    ax.grid(axis=\"x\", visible=False)\n",
        "\n",
        "    ax.spines[\"top\"].set_visible(False)\n",
        "    ax.spines[\"right\"].set_visible(False)\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    save_path = os.path.join(PLOTS_OUTPUT_DIR, output_name)\n",
        "\n",
        "    plt.savefig(save_path, format=\"svg\", bbox_inches=\"tight\", dpi=300)\n",
        "    plt.show()\n",
        "    plt.close()\n",
