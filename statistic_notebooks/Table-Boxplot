        "    f\"friedman_average_ranks_{metric_col}.csv\"\n",
        ")\n",
        "\n",
        "posthoc_csv_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    f\"posthoc_wilcoxon_holm_{metric_col}.csv\"\n",
        ")\n",
        "\n",
        "friedman_results.to_csv(\n",
        "    friedman_csv_path,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
