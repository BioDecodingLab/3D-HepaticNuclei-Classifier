    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import re\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import json\n",
        "\n",
        "from scipy.stats import friedmanchisquare, wilcoxon, rankdata\n",
        "from statsmodels.stats.multitest import multipletests\n",
        "from IPython.display import display\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. CONFIGURATION\n",
        "# ============================================================\n",
        "\n",
        "RESULTS_ROOT = \"/content/drive/MyDrive/Paper/results 1/results/DINO3D\"\n",
        "\n",
        "FINAL_OUTPUT_DIR = \"/content/drive/MyDrive/Paper/results 1/results/Resultado_final_DINO3D\"\n",
        "\n",
        "CSV_OUTPUT_DIR = os.path.join(FINAL_OUTPUT_DIR, \"csv_tables\")\n",
        "PLOTS_OUTPUT_DIR = os.path.join(FINAL_OUTPUT_DIR, \"boxplots_svg\")\n",
        "\n",
        "os.makedirs(FINAL_OUTPUT_DIR, exist_ok=True)\n",
        "os.makedirs(CSV_OUTPUT_DIR, exist_ok=True)\n",
        "os.makedirs(PLOTS_OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "\n",
        "MODEL_MAP = {\n",
        "    \"logreg\": \"Logistic Regression\",\n",
        "    \"rf\": \"Random Forest\",\n",
        "    \"svm\": \"Support Vector Machine\",\n",
        "    \"mlp\": \"MLP\"\n",
        "}\n",
        "\n",
        "LABEL_MAP = {\n",
        "    \"Logistic Regression\": \"LogReg\",\n",
        "    \"Random Forest\": \"RF\",\n",
        "    \"Support Vector Machine\": \"SVM\",\n",
        "    \"MLP\": \"MLP\",\n",
        "    \"logreg\": \"LogReg\",\n",
        "    \"rf\": \"RF\",\n",
        "    \"svm\": \"SVM\",\n",
        "    \"mlp\": \"MLP\"\n",
        "}\n",
        "\n",
        "MODEL_ORDER = [\"logreg\", \"rf\", \"svm\", \"mlp\"]\n",
        "\n",
        "VALID_AUGMENTATIONS = [\"noaug\", \"100\", \"500\", \"1000\", \"2000\", \"4000\"]\n",
        "\n",
        "EXPERIMENT_ORDER = [\n",
        "    \"LogReg\", \"LogReg +100\", \"LogReg +500\", \"LogReg +1000\", \"LogReg +2000\", \"LogReg +4000\",\n",
        "    \"RF\", \"RF +100\", \"RF +500\", \"RF +1000\", \"RF +2000\", \"RF +4000\",\n",
        "    \"SVM\", \"SVM +100\", \"SVM +500\", \"SVM +1000\", \"SVM +2000\", \"SVM +4000\",\n",
        "    \"MLP\", \"MLP +100\", \"MLP +500\", \"MLP +1000\", \"MLP +2000\", \"MLP +4000\"\n",
        "]\n",
        "\n",
        "TARGET_METRICS = [\n",
        "    \"accuracy\",\n",
        "    \"precision_weighted\",\n",
        "    \"recall_weighted\",\n",
        "    \"f1_weighted\",\n",
        "    \"precision_macro\",\n",
        "    \"recall_macro\",\n",
        "    \"f1_macro\",\n",
        "    \"balanced_accuracy\",\n",
        "    \"roc_auc_macro_ovr\"\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. BOXPLOT SETTINGS\n",
        "# ============================================================\n",
        "\n",
        "BOXPLOT_METRICS = {\n",
        "    \"roc_auc_macro_ovr\": {\n",
        "        \"ylabel\": \"Macro AUC OVR per fold\",\n",
        "        \"title\": \"Test Macro AUC by Model and Augmentation\",\n",
        "        \"filename\": \"test_macro_auc_boxplot_0_4_1_0.svg\",\n",
        "        \"ylim\": (0.4, 1.0)\n",
        "    },\n",
        "    \"f1_macro\": {\n",
        "        \"ylabel\": \"Macro F1 score per fold\",\n",
        "        \"title\": \"Test Macro F1 Score by Model and Augmentation\",\n",
        "        \"filename\": \"test_f1_macro_boxplot_0_4_0_7.svg\",\n",
        "        \"ylim\": (0.4, 1)\n",
        "    },\n",
        "    \"f1_weighted\": {\n",
        "        \"ylabel\": \"Weighted F1 score per fold\",\n",
        "        \"title\": \"Test Weighted F1 Score by Model and Augmentation\",\n",
        "        \"filename\": \"test_f1_weighted_boxplot_0_4_1_0.svg\",\n",
        "        \"ylim\": (0.4, 1.0)\n",
        "    },\n",
        "    \"balanced_accuracy\": {\n",
        "        \"ylabel\": \"Balanced accuracy per fold\",\n",
        "        \"title\": \"Test Balanced Accuracy by Model and Augmentation\",\n",
        "        \"filename\": \"test_balanced_accuracy_boxplot_0_4_0_7.svg\",\n",
        "        \"ylim\": (0.4, 1)\n",
        "    }\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. HELPER FUNCTIONS\n",
        "# ============================================================\n",
        "\n",
        "def parse_augmentation(folder_name):\n",
        "    m = re.match(r\"cv_benchmark_results_(.+?)_cv$\", folder_name.lower())\n",
        "    return m.group(1) if m else None\n",
        "\n",
        "\n",
        "def make_experiment_label(model, augmentation):\n",
        "    short_model = LABEL_MAP.get(str(model).strip(), str(model).strip())\n",
        "    aug = str(augmentation).strip().lower()\n",
        "\n",
        "    if aug == \"noaug\":\n",
        "        return short_model\n",
        "\n",
        "    return f\"{short_model} +{aug}\"\n",
        "\n",
        "\n",
        "def find_metrics_summary_file(fold_dir):\n",
        "    for fname in os.listdir(fold_dir):\n",
        "        low = fname.lower()\n",
        "\n",
        "        if low == \"metrics_summary\" or low == \"metrics_summary.csv\":\n",
        "            return os.path.join(fold_dir, fname)\n",
        "\n",
        "    for fname in os.listdir(fold_dir):\n",
        "        if \"metrics_summary\" in fname.lower():\n",
        "            return os.path.join(fold_dir, fname)\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def read_metrics_summary(file_path):\n",
        "    try:\n",
        "        df = pd.read_csv(file_path)\n",
        "    except Exception:\n",
        "        df = pd.read_csv(file_path, sep=None, engine=\"python\")\n",
        "\n",
        "    df.columns = [str(c).strip().lower() for c in df.columns]\n",
        "\n",
        "    if \"split\" not in df.columns:\n",
        "        raise ValueError(f\"No existe columna 'split' en {file_path}\")\n",
        "\n",
        "    df[\"split\"] = df[\"split\"].astype(str).str.strip().str.lower()\n",
        "\n",
        "    test_row = df[df[\"split\"] == \"test\"]\n",
        "\n",
        "    if test_row.empty:\n",
        "        raise ValueError(f\"No se encontró fila 'Test' en {file_path}\")\n",
        "\n",
        "    test_row = test_row.iloc[0]\n",
        "\n",
        "    result = {}\n",
        "\n",
        "    for metric in TARGET_METRICS:\n",
        "        result[metric] = pd.to_numeric(test_row.get(metric, None), errors=\"coerce\")\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. EXTRACT TEST METRICS FROM ALL FOLDS\n",
        "# ============================================================\n",
        "\n",
        "rows = []\n",
        "\n",
        "for folder_name in sorted(os.listdir(RESULTS_ROOT)):\n",
        "    folder_path = os.path.join(RESULTS_ROOT, folder_name)\n",
        "\n",
        "    if not os.path.isdir(folder_path):\n",
        "        continue\n",
        "\n",
        "    augmentation = parse_augmentation(folder_name)\n",
        "\n",
        "    if augmentation is None:\n",
        "        continue\n",
        "\n",
        "    augmentation = str(augmentation).strip().lower()\n",
        "\n",
        "    if augmentation not in VALID_AUGMENTATIONS:\n",
        "        continue\n",
        "\n",
        "    for model_key in MODEL_ORDER:\n",
        "        model_dir = os.path.join(folder_path, model_key)\n",
        "\n",
        "        if not os.path.isdir(model_dir):\n",
        "            print(f\"[WARNING] Model folder not found: {model_dir}\")\n",
        "            continue\n",
        "\n",
        "        for subfolder in sorted(os.listdir(model_dir)):\n",
        "            fold_dir = os.path.join(model_dir, subfolder)\n",
        "\n",
        "            if not os.path.isdir(fold_dir):\n",
        "                continue\n",
        "\n",
        "            if not re.match(r\"cv_fold_test_img_\\d+$\", subfolder.lower()):\n",
        "                continue\n",
        "\n",
        "            fold_match = re.search(r\"(\\d+)$\", subfolder)\n",
        "            fold_id = int(fold_match.group(1)) if fold_match else None\n",
        "\n",
        "            metrics_file = find_metrics_summary_file(fold_dir)\n",
        "\n",
        "            if metrics_file is None:\n",
        "                print(f\"[WARNING] metrics_summary not found in: {fold_dir}\")\n",
        "                continue\n",
        "\n",
        "            try:\n",
        "                metrics = read_metrics_summary(metrics_file)\n",
        "\n",
        "                row = {\n",
        "                    \"source_folder\": folder_name,\n",
        "                    \"model_key\": model_key,\n",
        "                    \"model\": MODEL_MAP[model_key],\n",
        "                    \"augmentation\": augmentation,\n",
        "                    \"fold\": fold_id,\n",
        "                    \"split\": \"Test\",\n",
        "                    \"metrics_file\": metrics_file\n",
        "                }\n",
        "\n",
        "                row.update(metrics)\n",
        "                rows.append(row)\n",
        "\n",
        "                print(f\"[OK] {folder_name} | {model_key} | fold {fold_id}\")\n",
        "\n",
        "            except Exception as e:\n",
        "                print(f\"[ERROR] {metrics_file}: {e}\")\n",
        "\n",
        "\n",
        "summary_df = pd.DataFrame(rows)\n",
        "\n",
        "if summary_df.empty:\n",
        "    raise ValueError(\"No data extracted. Check folders and metrics_summary files.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. CLEAN DATA\n",
        "# ============================================================\n",
        "\n",
        "summary_df[\"model\"] = summary_df[\"model\"].astype(str).str.strip()\n",
        "summary_df[\"augmentation\"] = summary_df[\"augmentation\"].astype(str).str.strip().str.lower()\n",
        "summary_df[\"fold\"] = pd.to_numeric(summary_df[\"fold\"], errors=\"coerce\")\n",
        "\n",
        "summary_df[\"experiment_label\"] = [\n",
        "    make_experiment_label(m, a)\n",
        "    for m, a in zip(summary_df[\"model\"], summary_df[\"augmentation\"])\n",
        "]\n",
        "\n",
        "summary_df = summary_df[summary_df[\"experiment_label\"].isin(EXPERIMENT_ORDER)].copy()\n",
        "\n",
        "for col in TARGET_METRICS:\n",
        "    summary_df[col] = pd.to_numeric(summary_df[col], errors=\"coerce\")\n",
        "\n",
        "summary_df = summary_df.sort_values(\n",
        "    [\"model_key\", \"augmentation\", \"fold\"]\n",
        ").reset_index(drop=True)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. SAVE FULL FOLD-LEVEL CSV\n",
        "# ============================================================\n",
        "\n",
        "full_csv_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    \"test_metrics_by_fold_all_experiments.csv\"\n",
        ")\n",
        "\n",
        "summary_df.to_csv(full_csv_path, index=False, encoding=\"utf-8-sig\")\n",
        "\n",
        "print(\"\\nSaved full fold-level table:\")\n",
        "print(full_csv_path)\n",
        "\n",
        "display(summary_df.head())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. SAVE AGGREGATED SUMMARY CSV\n",
        "# ============================================================\n",
        "\n",
        "agg_df = summary_df.groupby(\n",
        "    [\"experiment_label\", \"model\", \"augmentation\"],\n",
        "    as_index=False\n",
        ")[TARGET_METRICS].agg([\"mean\", \"std\", \"median\"])\n",
        "\n",
        "agg_df.columns = [\n",
        "    \"_\".join(col).strip(\"_\") if isinstance(col, tuple) else col\n",
        "    for col in agg_df.columns\n",
        "]\n",
        "\n",
        "agg_csv_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    \"test_metrics_aggregated_mean_std_median.csv\"\n",
        ")\n",
        "\n",
        "agg_df.to_csv(agg_csv_path, index=False, encoding=\"utf-8-sig\")\n",
        "\n",
        "print(\"\\nSaved aggregated table:\")\n",
        "print(agg_csv_path)\n",
        "\n",
        "display(agg_df.head())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. CHECK METRIC RANGES\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\nMetric ranges used for boxplots:\")\n",
        "\n",
        "for metric in BOXPLOT_METRICS.keys():\n",
        "    metric_min = summary_df[metric].min()\n",
        "    metric_max = summary_df[metric].max()\n",
        "    ylim = BOXPLOT_METRICS[metric][\"ylim\"]\n",
        "\n",
        "    print(f\"{metric}: min={metric_min:.4f}, max={metric_max:.4f}, ylim={ylim}\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. CREATE BOXPLOTS SVG\n",
        "# ============================================================\n",
        "\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "\n",
        "def make_boxplot(data, y_col, y_label, title, output_name, ylim):\n",
        "    plot_df = data[[\"experiment_label\", y_col]].dropna().copy()\n",
        "\n",
        "    if plot_df.empty:\n",
        "        raise ValueError(f\"No data available for {y_col}\")\n",
        "\n",
        "    print(f\"\\nPlotting: {y_col}\")\n",
        "    print(\"Min:\", plot_df[y_col].min())\n",
        "    print(\"Max:\", plot_df[y_col].max())\n",
        "    print(\"Y limit:\", ylim)\n",
        "\n",
        "    plt.figure(figsize=(24, 8))\n",
        "\n",
        "    ax = sns.boxplot(\n",
        "        data=plot_df,\n",
        "        x=\"experiment_label\",\n",
        "        y=y_col,\n",
        "        order=EXPERIMENT_ORDER,\n",
        "        width=0.58,\n",
        "        showcaps=True,\n",
        "        showfliers=False,\n",
        "        boxprops=dict(\n",
        "            facecolor=\"#cfe8ff\",\n",
        "            edgecolor=\"#1f4e79\",\n",
        "            linewidth=1.8\n",
        "        ),\n",
        "        whiskerprops=dict(\n",
        "            color=\"#1f4e79\",\n",
        "            linewidth=1.8\n",
        "        ),\n",
        "        capprops=dict(\n",
        "            color=\"#1f4e79\",\n",
        "            linewidth=1.8\n",
        "        ),\n",
        "        medianprops=dict(\n",
        "            color=\"#08306b\",\n",
        "            linewidth=2.5\n",
        "        )\n",
        "    )\n",
        "\n",
        "    sns.stripplot(\n",
        "        data=plot_df,\n",
        "        x=\"experiment_label\",\n",
        "        y=y_col,\n",
        "        order=EXPERIMENT_ORDER,\n",
        "        color=\"#0b3d91\",\n",
        "        size=4,\n",
        "        alpha=0.7,\n",
        "        jitter=0.16,\n",
        "        ax=ax\n",
        "    )\n",
        "\n",
        "    ax.set_xlabel(\n",
        "        \"Model and augmentation setting\",\n",
        "        fontsize=13,\n",
        "        fontweight=\"bold\"\n",
        "    )\n",
        "\n",
        "    ax.set_ylabel(\n",
        "        y_label,\n",
        "        fontsize=13,\n",
        "        fontweight=\"bold\"\n",
        "    )\n",
        "\n",
        "    ax.set_title(\n",
        "        title,\n",
        "        fontsize=15,\n",
        "        fontweight=\"bold\",\n",
        "        pad=14\n",
        "    )\n",
        "\n",
        "    ax.set_ylim(ylim[0], ylim[1])\n",
        "\n",
        "    plt.xticks(rotation=45, ha=\"right\", fontsize=10)\n",
        "    plt.yticks(fontsize=10)\n",
        "\n",
        "    ax.grid(axis=\"y\", linestyle=\"--\", alpha=0.25)\n",
        "    ax.grid(axis=\"x\", visible=False)\n",
        "\n",
        "    ax.spines[\"top\"].set_visible(False)\n",
        "    ax.spines[\"right\"].set_visible(False)\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    save_path = os.path.join(PLOTS_OUTPUT_DIR, output_name)\n",
        "\n",
        "    plt.savefig(save_path, format=\"svg\", bbox_inches=\"tight\", dpi=300)\n",
        "    plt.show()\n",
        "    plt.close()\n",
        "\n",
        "    print(f\"Saved boxplot: {save_path}\")\n",
        "\n",
        "\n",
        "for metric, info in BOXPLOT_METRICS.items():\n",
        "    make_boxplot(\n",
        "        data=summary_df,\n",
        "        y_col=metric,\n",
        "        y_label=info[\"ylabel\"],\n",
        "        title=info[\"title\"],\n",
        "        output_name=info[\"filename\"],\n",
        "        ylim=info[\"ylim\"]\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. FRIEDMAN + WILCOXON HOLM FOR F1 MACRO\n",
        "# ============================================================\n",
        "\n",
        "metric_col = \"f1_macro\"\n",
        "\n",
        "stats_df = summary_df.dropna(\n",
        "    subset=[\"fold\", metric_col, \"experiment_label\"]\n",
        ").copy()\n",
        "\n",
        "pivot_df = stats_df.pivot_table(\n",
        "    index=\"fold\",\n",
        "    columns=\"experiment_label\",\n",
        "    values=metric_col,\n",
        "    aggfunc=\"mean\"\n",
        ")\n",
        "\n",
        "available_cols = [\n",
        "    col for col in EXPERIMENT_ORDER\n",
        "    if col in pivot_df.columns\n",
        "]\n",
        "\n",
        "pivot_df = pivot_df[available_cols]\n",
        "\n",
        "pivot_df = pivot_df.dropna(axis=0, how=\"any\")\n",
        "\n",
        "pivot_csv_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    f\"paired_matrix_{metric_col}.csv\"\n",
        ")\n",
        "\n",
        "pivot_df.to_csv(pivot_csv_path, encoding=\"utf-8-sig\")\n",
        "\n",
        "print(\"\\nSaved paired matrix:\")\n",
        "print(pivot_csv_path)\n",
        "\n",
        "display(pivot_df)\n",
        "\n",
        "if pivot_df.shape[0] < 2:\n",
        "    raise ValueError(\"Not enough folds for statistical analysis.\")\n",
        "\n",
        "if pivot_df.shape[1] < 3:\n",
        "    raise ValueError(\"At least 3 experiments are required for Friedman test.\")\n",
        "\n",
        "\n",
        "friedman_stat, friedman_p = friedmanchisquare(\n",
        "    *[pivot_df[col].values for col in pivot_df.columns]\n",
        ")\n",
        "\n",
        "ranks_per_fold = pivot_df.apply(\n",
        "    lambda row: rankdata(-row.values, method=\"average\"),\n",
        "    axis=1,\n",
        "    result_type=\"expand\"\n",
        ")\n",
        "\n",
        "ranks_per_fold.columns = pivot_df.columns\n",
        "\n",
        "avg_ranks_df = pd.DataFrame({\n",
        "    \"experiment\": ranks_per_fold.columns,\n",
        "    \"average_rank\": ranks_per_fold.mean(axis=0).values,\n",
        "    \"mean_metric\": pivot_df.mean(axis=0).values,\n",
        "    \"std_metric\": pivot_df.std(axis=0, ddof=1).values,\n",
        "    \"median_metric\": pivot_df.median(axis=0).values\n",
        "})\n",
        "\n",
        "avg_ranks_df = avg_ranks_df.sort_values(\n",
        "    [\"average_rank\", \"mean_metric\"],\n",
        "    ascending=[True, False]\n",
        ").reset_index(drop=True)\n",
        "\n",
        "best_experiment = avg_ranks_df.iloc[0][\"experiment\"]\n",
        "\n",
        "friedman_results = pd.DataFrame([{\n",
        "    \"metric\": metric_col,\n",
        "    \"best_experiment_selected_by_friedman_rank\": best_experiment,\n",
        "    \"n_folds\": pivot_df.shape[0],\n",
        "    \"n_experiments\": pivot_df.shape[1],\n",
        "    \"friedman_statistic\": friedman_stat,\n",
        "    \"friedman_p_value\": friedman_p\n",
        "}])\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. POST HOC WILCOXON + HOLM\n",
        "# ============================================================\n",
        "\n",
        "baseline_values = pivot_df[best_experiment].values\n",
        "\n",
        "posthoc_rows = []\n",
        "\n",
        "for exp in pivot_df.columns:\n",
        "    if exp == best_experiment:\n",
        "        continue\n",
        "\n",
        "    comparison_values = pivot_df[exp].values\n",
        "\n",
        "    if np.allclose(baseline_values, comparison_values):\n",
        "        stat = 0.0\n",
        "        p_value = 1.0\n",
        "    else:\n",
        "        try:\n",
        "            stat, p_value = wilcoxon(\n",
        "                baseline_values,\n",
        "                comparison_values,\n",
        "                zero_method=\"wilcox\",\n",
        "                alternative=\"two-sided\",\n",
        "                mode=\"auto\"\n",
        "            )\n",
        "        except ValueError:\n",
        "            stat = np.nan\n",
        "            p_value = 1.0\n",
        "\n",
        "    baseline_mean = np.mean(baseline_values)\n",
        "    comparison_mean = np.mean(comparison_values)\n",
        "\n",
        "    posthoc_rows.append({\n",
        "        \"baseline_best_experiment\": best_experiment,\n",
        "        \"comparison\": exp,\n",
        "        \"baseline_mean\": baseline_mean,\n",
        "        \"comparison_mean\": comparison_mean,\n",
        "        \"mean_difference\": baseline_mean - comparison_mean,\n",
        "        \"wilcoxon_statistic\": stat,\n",
        "        \"p_value_raw\": p_value\n",
        "    })\n",
        "\n",
        "posthoc_df = pd.DataFrame(posthoc_rows)\n",
        "\n",
        "reject, pvals_corrected, _, _ = multipletests(\n",
        "    posthoc_df[\"p_value_raw\"].values,\n",
        "    alpha=0.05,\n",
        "    method=\"holm\"\n",
        ")\n",
        "\n",
        "posthoc_df[\"p_value_holm\"] = pvals_corrected\n",
        "posthoc_df[\"reject_h0_holm\"] = reject\n",
        "\n",
        "\n",
        "def interpret(row):\n",
        "    if row[\"reject_h0_holm\"]:\n",
        "        if row[\"mean_difference\"] > 0:\n",
        "            return f\"{row['baseline_best_experiment']} significantly better\"\n",
        "        elif row[\"mean_difference\"] < 0:\n",
        "            return f\"{row['comparison']} significantly better\"\n",
        "        else:\n",
        "            return \"significant difference\"\n",
        "\n",
        "    return \"no significant difference\"\n",
        "\n",
        "\n",
        "posthoc_df[\"interpretation\"] = posthoc_df.apply(interpret, axis=1)\n",
        "\n",
        "posthoc_df = posthoc_df.sort_values(\n",
        "    [\"p_value_holm\", \"p_value_raw\", \"comparison\"]\n",
        ").reset_index(drop=True)\n",
