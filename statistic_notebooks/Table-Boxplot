        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. SAVE AGGREGATED SUMMARY CSV\n",
        "# ============================================================\n",
        "\n",
        "agg_df = summary_df.groupby(\n",
        "    [\"experiment_label\", \"model\", \"augmentation\"],\n",
        "    as_index=False\n",
        ")[TARGET_METRICS].agg([\"mean\", \"std\", \"median\", \"min\", \"max\"])\n",
