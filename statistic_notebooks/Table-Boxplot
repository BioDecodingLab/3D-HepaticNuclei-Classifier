        "    \"median\": resnet_best_df[MAIN_METRIC].median(),\n",
        "    \"count\": resnet_best_df[MAIN_METRIC].count(),\n",
        "    \"family\": \"ResNet3D-18\"\n",
        "}])\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. BUILD DISPLAY LABELS\n",
        "# ============================================================\n",
        "\n",
        "dino_display_label = build_display_label(\"DINO3D\", dino_best_name)\n",
        "resnet_display_label = build_display_label(\"ResNet3D-18\", resnet_best_name)\n",
        "features_display_label = build_display_label(\"Features\", features_best_name)\n",
        "\n",
        "dino_best_df[\"display_label\"] = dino_display_label\n",
        "resnet_best_df[\"display_label\"] = resnet_display_label\n",
        "features_best_df[\"display_label\"] = features_display_label\n",
        "\n",
        "manual_display_order = [\n",
        "    dino_display_label,\n",
        "    resnet_display_label,\n",
        "    features_display_label\n",
        "]\n",
        "\n",
        "selected_summary = pd.DataFrame([\n",
        "    {\n",
        "        \"family\": \"DINO3D\",\n",
        "        \"selected_experiment\": dino_best_name,\n",
        "        \"display_label\": dino_display_label,\n",
        "        \"selection_metric\": MAIN_METRIC\n",
        "    },\n",
        "    {\n",
        "        \"family\": \"ResNet3D-18\",\n",
        "        \"selected_experiment\": resnet_best_name,\n",
        "        \"display_label\": resnet_display_label,\n",
        "        \"selection_metric\": MAIN_METRIC\n",
        "    },\n",
        "    {\n",
        "        \"family\": \"Features\",\n",
        "        \"selected_experiment\": features_best_name,\n",
        "        \"display_label\": features_display_label,\n",
        "        \"selection_metric\": MAIN_METRIC\n",
        "    }\n",
        "])\n",
        "\n",
        "all_rankings = pd.concat(\n",
        "    [dino_ranking, resnet_ranking, features_ranking],\n",
        "    ignore_index=True\n",
        ")\n",
        "\n",
        "selected_summary_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    f\"selected_best_experiments_by_{MAIN_METRIC}.csv\"\n",
        ")\n",
        "\n",
        "ranking_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    f\"ranking_by_family_{MAIN_METRIC}.csv\"\n",
        ")\n",
        "\n",
        "selected_summary.to_csv(\n",
        "    selected_summary_path,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "all_rankings.to_csv(\n",
        "    ranking_path,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "print(\"\\nSelected best experiments:\")\n",
        "display(selected_summary)\n",
        "\n",
        "print(\"\\nRanking by family:\")\n",
        "display(all_rankings)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. COMBINE THE SELECTED BEST MODELS\n",
        "# ============================================================\n",
        "\n",
        "combined_df = pd.concat(\n",
        "    [dino_best_df, resnet_best_df, features_best_df],\n",
        "    ignore_index=True\n",
        ")\n",
        "\n",
        "combined_df = combined_df.dropna(\n",
        "    subset=[\"fold\", \"display_label\"] + METRIC_COLS\n",
        ").copy()\n",
        "\n",
        "display_order = get_display_order(\n",
        "    combined_df,\n",
        "    MAIN_METRIC,\n",
        "    manual_display_order\n",
        ")\n",
        "\n",
        "combined_df[\"display_label\"] = pd.Categorical(\n",
        "    combined_df[\"display_label\"],\n",
        "    categories=display_order,\n",
        "    ordered=True\n",
        ")\n",
        "\n",
        "combined_df = combined_df.sort_values(\n",
        "    [\"display_label\", \"fold\"]\n",
        ").reset_index(drop=True)\n",
        "\n",
        "combined_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    f\"combined_best_models_by_fold_{MAIN_METRIC}.csv\"\n",
        ")\n",
        "\n",
        "combined_df.to_csv(\n",
        "    combined_path,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "print(\"\\nCombined data:\")\n",
        "display(combined_df)\n",
        "\n",
        "print(\"\\nBoxplot order:\")\n",
        "print(display_order)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. SAVE BOXPLOT ORDER\n",
        "# ============================================================\n",
        "\n",
        "order_df = pd.DataFrame({\n",
        "    \"boxplot_order\": display_order,\n",
        "    \"mean_main_metric\": [\n",
        "        combined_df.loc[\n",
        "            combined_df[\"display_label\"] == item,\n",
        "            MAIN_METRIC\n",
        "        ].mean()\n",
        "        for item in display_order\n",
        "    ]\n",
        "})\n",
        "\n",
        "order_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    f\"boxplot_order_{MAIN_METRIC}.csv\"\n",
        ")\n",
        "\n",
        "order_df.to_csv(\n",
        "    order_path,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "print(\"\\nBoxplot order table:\")\n",
        "display(order_df)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. SAVE SUMMARY STATISTICS\n",
        "# ============================================================\n",
        "\n",
        "summary_stats = (\n",
        "    combined_df.groupby(\"display_label\", observed=True)[METRIC_COLS]\n",
        "    .agg([\"mean\", \"std\", \"median\", \"min\", \"max\", \"count\"])\n",
        ")\n",
        "\n",
        "summary_stats.columns = [\n",
        "    \"_\".join(col).strip(\"_\")\n",
        "    for col in summary_stats.columns\n",
        "]\n",
        "\n",
        "summary_stats = summary_stats.reset_index()\n",
        "\n",
        "summary_stats_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    \"summary_statistics_best_models.csv\"\n",
        ")\n",
        "\n",
        "summary_stats.to_csv(\n",
        "    summary_stats_path,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "print(\"\\nSummary statistics:\")\n",
        "display(summary_stats)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. CREATE BOXPLOTS WITH COHEN'S d\n",
        "# ============================================================\n",
        "\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "\n",
        "def make_comparison_boxplot(data, metric_col, display_order):\n",
        "    metric_label = METRIC_LABELS.get(metric_col, metric_col)\n",
        "\n",
        "    pivot_df = build_paired_matrix(\n",
        "        data=data,\n",
        "        metric_col=metric_col,\n",
        "        order=display_order\n",
        "    )\n",
        "\n",
        "    if pivot_df.shape[0] < 2:\n",
        "        print(f\"[WARNING] Not enough paired folds for {metric_col}. Skipping plot.\")\n",
        "        return None, None\n",
        "\n",
        "    effect_df = compute_pairwise_effects(\n",
        "        pivot_df=pivot_df,\n",
        "        metric_col=metric_col,\n",
        "        display_order=display_order\n",
        "    )\n",
        "\n",
        "    pivot_path = os.path.join(\n",
        "        CSV_OUTPUT_DIR,\n",
        "        f\"paired_matrix_best_models_{metric_col}.csv\"\n",
        "    )\n",
        "\n",
        "    effect_path = os.path.join(\n",
        "        CSV_OUTPUT_DIR,\n",
        "        f\"paired_cohens_d_best_models_{metric_col}.csv\"\n",
        "    )\n",
        "\n",
        "    pivot_df.to_csv(\n",
        "        pivot_path,\n",
        "        encoding=\"utf-8-sig\"\n",
        "    )\n",
        "\n",
        "    effect_df.to_csv(\n",
        "        effect_path,\n",
        "        index=False,\n",
        "        encoding=\"utf-8-sig\"\n",
        "    )\n",
        "\n",
        "    plot_df = pivot_df.reset_index().melt(\n",
        "        id_vars=\"fold\",\n",
        "        value_vars=display_order,\n",
        "        var_name=\"display_label\",\n",
        "        value_name=metric_col\n",
        "    )\n",
        "\n",
        "    plot_data_path = os.path.join(\n",
        "        CSV_OUTPUT_DIR,\n",
        "        f\"plot_data_best_models_{metric_col}.csv\"\n",
        "    )\n",
        "\n",
        "    plot_df.to_csv(\n",
        "        plot_data_path,\n",
        "        index=False,\n",
        "        encoding=\"utf-8-sig\"\n",
        "    )\n",
        "\n",
        "    plt.figure(figsize=(10, 7))\n",
        "\n",
        "    ax = sns.boxplot(\n",
        "        data=plot_df,\n",
        "        x=\"display_label\",\n",
        "        y=metric_col,\n",
        "        order=display_order,\n",
        "        width=0.5,\n",
        "        showcaps=True,\n",
        "        showfliers=False,\n",
        "        boxprops=dict(\n",
        "            facecolor=\"#d8ebff\",\n",
        "            edgecolor=\"#1f4e79\",\n",
        "            linewidth=1.8\n",
        "        ),\n",
        "        whiskerprops=dict(\n",
        "            color=\"#1f4e79\",\n",
        "            linewidth=1.8\n",
        "        ),\n",
        "        capprops=dict(\n",
        "            color=\"#1f4e79\",\n",
        "            linewidth=1.8\n",
        "        ),\n",
        "        medianprops=dict(\n",
        "            color=\"#08306b\",\n",
        "            linewidth=2.4\n",
        "        )\n",
        "    )\n",
        "\n",
        "    sns.stripplot(\n",
        "        data=plot_df,\n",
        "        x=\"display_label\",\n",
        "        y=metric_col,\n",
        "        order=display_order,\n",
        "        color=\"#0b3d91\",\n",
        "        size=6,\n",
        "        alpha=0.75,\n",
        "        jitter=0.10,\n",
        "        ax=ax\n",
        "    )\n",
        "\n",
        "    ax.set_xlabel(\n",
        "        \"Best model per approach\",\n",
        "        fontsize=13,\n",
        "        fontweight=\"bold\"\n",
        "    )\n",
        "\n",
        "    ax.set_ylabel(\n",
        "        metric_label,\n",
        "        fontsize=13,\n",
        "        fontweight=\"bold\"\n",
        "    )\n",
        "\n",
        "    ax.set_title(\n",
        "        f\"Best model comparison - {metric_label}\",\n",
        "        fontsize=15,\n",
        "        fontweight=\"bold\",\n",
        "        pad=14\n",
        "    )\n",
        "\n",
        "    ax.set_ylim(Y_AXIS_LIMITS[0], Y_AXIS_LIMITS[1])\n",
        "\n",
        "    plt.xticks(rotation=0, fontsize=10)\n",
        "    plt.yticks(fontsize=10)\n",
        "\n",
        "    ax.grid(axis=\"y\", linestyle=\"--\", alpha=0.25)\n",
        "    ax.grid(axis=\"x\", visible=False)\n",
        "\n",
        "    ax.spines[\"top\"].set_visible(False)\n",
        "    ax.spines[\"right\"].set_visible(False)\n",
        "\n",
        "    x_positions = {\n",
        "        family: idx\n",
        "        for idx, family in enumerate(display_order)\n",
        "    }\n",
        "\n",
        "    adjacent_pairs = [\n",
        "        (display_order[i], display_order[i + 1])\n",
        "        for i in range(len(display_order) - 1)\n",
        "    ]\n",
        "\n",
        "    for idx, (left_model, right_model) in enumerate(adjacent_pairs):\n",
        "        row = effect_df[\n",
        "            (effect_df[\"left_model\"] == left_model) &\n",
        "            (effect_df[\"right_model\"] == right_model)\n",
        "        ]\n",
        "\n",
        "        if row.empty:\n",
        "            continue\n",
        "\n",
        "        row = row.iloc[0]\n",
        "\n",
        "        d_value = row[\"cohens_d_paired\"]\n",
        "        interpretation = row[\"effect_size_interpretation\"]\n",
        "\n",
        "        if pd.isna(d_value):\n",
        "            label = \"d = NaN\"\n",
        "        else:\n",
        "            label = f\"d = {d_value:.2f} ({interpretation})\"\n",
        "\n",
        "        pair_values = plot_df[\n",
        "            plot_df[\"display_label\"].isin([left_model, right_model])\n",
        "        ][metric_col]\n",
        "\n",
        "        pair_max = pair_values.max()\n",
        "\n",
        "        y = pair_max + BRACKET_OFFSET\n",
        "\n",
        "        if y + BRACKET_HEIGHT > BRACKET_MAX_Y:\n",
        "            y = BRACKET_MAX_Y - BRACKET_HEIGHT\n",
        "\n",
        "        x1 = x_positions[left_model]\n",
        "        x2 = x_positions[right_model]\n",
        "\n",
        "        add_bracket(\n",
        "            ax=ax,\n",
        "            x1=x1,\n",
        "            x2=x2,\n",
        "            y=y,\n",
        "            h=BRACKET_HEIGHT,\n",
        "            text=label\n",
        "        )\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    plot_path = os.path.join(\n",
        "        PLOT_OUTPUT_DIR,\n",
        "        f\"boxplot_best_models_with_cohens_d_{metric_col}.svg\"\n",
        "    )\n",
        "\n",
        "    plt.savefig(\n",
        "        plot_path,\n",
        "        format=\"svg\",\n",
        "        bbox_inches=\"tight\",\n",
        "        dpi=300\n",
        "    )\n",
        "\n",
        "    plt.show()\n",
        "    plt.close()\n",
        "\n",
        "    print(f\"\\nSaved plot: {plot_path}\")\n",
        "    print(f\"Saved paired matrix: {pivot_path}\")\n",
        "    print(f\"Saved Cohen's d table: {effect_path}\")\n",
        "\n",
        "    return pivot_df, effect_df\n",
        "\n",
        "\n",
        "all_effect_tables = []\n",
        "\n",
        "for metric_col in METRIC_COLS:\n",
        "    pivot_df_metric, effect_df_metric = make_comparison_boxplot(\n",
        "        data=combined_df,\n",
        "        metric_col=metric_col,\n",
        "        display_order=display_order\n",
        "    )\n",
        "\n",
        "    if effect_df_metric is not None:\n",
        "        all_effect_tables.append(effect_df_metric)\n",
        "\n",
        "if all_effect_tables:\n",
        "    all_effects_df = pd.concat(\n",
        "        all_effect_tables,\n",
        "        ignore_index=True\n",
        "    )\n",
        "\n",
        "    all_effects_path = os.path.join(\n",
        "        CSV_OUTPUT_DIR,\n",
        "        \"paired_cohens_d_all_metrics.csv\"\n",
        "    )\n",
        "\n",
        "    all_effects_df.to_csv(\n",
        "        all_effects_path,\n",
        "        index=False,\n",
        "        encoding=\"utf-8-sig\"\n",
        "    )\n",
        "\n",
        "    print(\"\\nAll Cohen's d results:\")\n",
        "    display(all_effects_df)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. FRIEDMAN TEST FOR THE MAIN METRIC\n",
        "# ============================================================\n",
        "\n",
        "main_pivot_df = build_paired_matrix(\n",
        "    data=combined_df,\n",
        "    metric_col=MAIN_METRIC,\n",
        "    order=display_order\n",
        ")\n",
        "\n",
        "main_pivot_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    f\"friedman_paired_matrix_{MAIN_METRIC}.csv\"\n",
        ")\n",
        "\n",
        "main_pivot_df.to_csv(\n",
        "    main_pivot_path,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "print(\"\\nPaired matrix for Friedman:\")\n",
        "display(main_pivot_df)\n",
        "\n",
        "if main_pivot_df.shape[0] < 2:\n",
        "    raise ValueError(\"Not enough paired folds for Friedman test.\")\n",
        "\n",
        "if main_pivot_df.shape[1] < 3:\n",
        "    raise ValueError(\"At least 3 experiments are required for Friedman test.\")\n",
        "\n",
        "friedman_stat, friedman_p = friedmanchisquare(\n",
        "    *[main_pivot_df[col].values for col in main_pivot_df.columns]\n",
        ")\n",
        "\n",
        "ranks_per_fold = main_pivot_df.apply(\n",
        "    lambda row: rankdata(-row.values, method=\"average\"),\n",
        "    axis=1,\n",
        "    result_type=\"expand\"\n",
        ")\n",
        "\n",
        "ranks_per_fold.columns = main_pivot_df.columns\n",
        "\n",
        "avg_ranks_df = pd.DataFrame({\n",
        "    \"experiment\": ranks_per_fold.columns,\n",
        "    \"average_rank\": ranks_per_fold.mean(axis=0).values,\n",
        "    f\"mean_{MAIN_METRIC}\": main_pivot_df.mean(axis=0).values,\n",
        "    f\"std_{MAIN_METRIC}\": main_pivot_df.std(axis=0, ddof=1).values,\n",
        "    f\"median_{MAIN_METRIC}\": main_pivot_df.median(axis=0).values\n",
        "})\n",
        "\n",
        "avg_ranks_df = avg_ranks_df.sort_values(\n",
        "    [\"average_rank\", f\"mean_{MAIN_METRIC}\"],\n",
        "    ascending=[True, False]\n",
        ").reset_index(drop=True)\n",
        "\n",
        "best_model = avg_ranks_df.iloc[0][\"experiment\"]\n",
        "\n",
        "friedman_results = pd.DataFrame([{\n",
        "    \"metric\": MAIN_METRIC,\n",
        "    \"n_folds\": main_pivot_df.shape[0],\n",
        "    \"n_experiments\": main_pivot_df.shape[1],\n",
        "    \"best_model_by_average_rank\": best_model,\n",
        "    \"friedman_statistic\": friedman_stat,\n",
        "    \"friedman_p_value\": friedman_p\n",
        "}])\n",
        "\n",
        "friedman_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    f\"friedman_final_best_models_{MAIN_METRIC}.csv\"\n",
        ")\n",
        "\n",
        "avg_ranks_path = os.path.join(\n",
        "    CSV_OUTPUT_DIR,\n",
        "    f\"friedman_average_ranks_final_best_models_{MAIN_METRIC}.csv\"\n",
        ")\n",
        "\n",
        "friedman_results.to_csv(\n",
        "    friedman_path,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "avg_ranks_df.to_csv(\n",
        "    avg_ranks_path,\n",
        "    index=False,\n",
        "    encoding=\"utf-8-sig\"\n",
        ")\n",
        "\n",
        "print(\"\\nFriedman results:\")\n",
        "display(friedman_results)\n",
        "\n",
        "print(\"\\nAverage ranks:\")\n",
        "display(avg_ranks_df)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 13. POST HOC WILCOXON + HOLM FOR THE MAIN METRIC\n",
        "# ============================================================\n",
        "\n",
        "baseline_values = main_pivot_df[best_model].values\n",
        "posthoc_rows = []\n",
        "\n",
        "for exp in main_pivot_df.columns:\n",
        "    if exp == best_model:\n",
        "        continue\n",
        "\n",
        "    comparison_values = main_pivot_df[exp].values\n",
        "\n",
        "    try:\n",
        "        stat, p_value = wilcoxon(\n",
        "            baseline_values,\n",
        "            comparison_values,\n",
        "            zero_method=\"wilcox\",\n",
        "            alternative=\"two-sided\",\n",
        "            mode=\"auto\"\n",
        "        )\n",
        "    except ValueError:\n",
        "        stat = np.nan\n",
        "        p_value = 1.0\n",
        "\n",
        "    posthoc_rows.append({\n",
        "        \"metric\": MAIN_METRIC,\n",
        "        \"baseline_best_model\": best_model,\n",
        "        \"comparison\": exp,\n",
        "        \"baseline_mean\": np.mean(baseline_values),\n",
        "        \"comparison_mean\": np.mean(comparison_values),\n",
        "        \"mean_difference\": np.mean(baseline_values) - np.mean(comparison_values),\n",
