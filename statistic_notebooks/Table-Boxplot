        "import os\n",
        "import re\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from scipy.stats import friedmanchisquare, wilcoxon, rankdata\n",
        "from statsmodels.stats.multitest import multipletests\n",
        "from IPython.display import display\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. PATHS\n",
        "# ============================================================\n",
        "\n",
        "BASE_RESULTS_DIR = \"/content/drive/MyDrive/Paper/results 1/results\"\n",
        "\n",
        "DINO_DIR = os.path.join(BASE_RESULTS_DIR, \"Resultado_final_DINO3D\")\n",
        "RESNET_DIR = os.path.join(BASE_RESULTS_DIR, \"Resultado_final_resnet\")\n",
        "FEATURES_DIR = os.path.join(BASE_RESULTS_DIR, \"Resultado_final_Features\")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(BASE_RESULTS_DIR, \"Resultado_final_modelos\")\n",
        "CSV_OUTPUT_DIR = os.path.join(OUTPUT_DIR, \"csv_tables\")\n",
        "PLOT_OUTPUT_DIR = os.path.join(OUTPUT_DIR, \"plots_svg\")\n",
        "\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "os.makedirs(CSV_OUTPUT_DIR, exist_ok=True)\n",
        "os.makedirs(PLOT_OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. INPUT CSV FILES\n",
        "# ============================================================\n",
        "\n",
        "DINO_CSV = os.path.join(\n",
        "    DINO_DIR,\n",
        "    \"csv_tables\",\n",
        "    \"test_metrics_by_fold_all_experiments.csv\"\n",
        ")\n",
        "\n",
        "RESNET_CSV = os.path.join(\n",
        "    RESNET_DIR,\n",
        "    \"csv_tables\",\n",
        "    \"resnet3d_18_test_metrics_by_fold.csv\"\n",
        ")\n",
        "\n",
        "FEATURES_CSV = os.path.join(\n",
        "    FEATURES_DIR,\n",
        "    \"csv_tables\",\n",
        "    \"test_metrics_by_fold_all_experiments.csv\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. GENERAL SETTINGS\n",
        "# ============================================================\n",
        "\n",
        "METRIC_COLS = [\n",
        "    \"f1_macro\",\n",
        "    \"f1_weighted\",\n",
        "    \"balanced_accuracy\"\n",
        "]\n",
        "\n",
        "MAIN_METRIC = \"f1_macro\"\n",
        "\n",
        "METRIC_LABELS = {\n",
        "    \"f1_macro\": \"Macro F1 score per fold\",\n",
        "    \"f1_weighted\": \"Weighted F1 score per fold\",\n",
        "    \"balanced_accuracy\": \"Balanced accuracy per fold\"\n",
        "}\n",
        "\n",
        "# \"manual\" keeps the family order:\n",
        "# DINO3D -> ResNet3D-18 -> Features\n",
        "# \"auto\" sorts by the selected MAIN_METRIC mean.\n",
        "ORDER_MODE = \"manual\"\n",
        "\n",
        "Y_AXIS_LIMITS = (0.4, 1.0)\n",
        "\n",
        "BRACKET_OFFSET = 0.025\n",
        "BRACKET_HEIGHT = 0.012\n",
        "BRACKET_MAX_Y = 0.975\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. HELPER FUNCTIONS\n",
        "# ============================================================\n",
        "\n",
        "def check_file_exists(path, label):\n",
        "    if not os.path.exists(path):\n",
        "        raise FileNotFoundError(f\"{label} file not found: {path}\")\n",
        "    return path\n",
        "\n",
        "\n",
        "def normalize_model(model, model_key=None):\n",
        "    raw = str(model_key if model_key is not None else model).strip().lower()\n",
        "    raw_model = str(model).strip().lower()\n",
        "\n",
        "    if raw in [\"rf\", \"random_forest\", \"random forest\"] or \"random forest\" in raw_model:\n",
        "        return \"RF\"\n",
        "\n",
        "    if raw in [\"svm\", \"support_vector_machine\", \"support vector machine\"] or \"svm\" in raw_model:\n",
        "        return \"SVM\"\n",
        "\n",
        "    if raw in [\"logreg\", \"logistic regression\", \"logistic_regression\"] or \"logistic\" in raw_model:\n",
        "        return \"LogReg\"\n",
        "\n",
        "    if raw in [\"mlp\"] or \"mlp\" in raw_model:\n",
        "        return \"MLP\"\n",
        "\n",
        "    if \"resnet\" in raw or \"resnet\" in raw_model:\n",
        "        return \"ResNet3D-18\"\n",
        "\n",
        "    return str(model).strip()\n",
        "\n",
        "\n",
        "def normalize_augmentation(augmentation):\n",
        "    aug = str(augmentation).strip().lower()\n",
        "\n",
        "    if aug in [\"noaug\", \"no_aug\", \"none\", \"nan\", \"0\"]:\n",
        "        return \"noaug\"\n",
        "\n",
        "    for n in [\"4000\", \"2000\", \"1000\", \"500\", \"100\"]:\n",
        "        if n in aug:\n",
        "            return n\n",
        "\n",
        "    return aug\n",
        "\n",
        "\n",
        "def compact_experiment_label(label):\n",
        "    label = str(label).strip()\n",
        "    label = re.sub(r\"\\s*\\+\\s*\", \"+\", label)\n",
        "    return label\n",
        "\n",
        "\n",
        "def create_experiment_label(row):\n",
        "    if \"experiment_label\" in row.index and pd.notna(row[\"experiment_label\"]):\n",
        "        return compact_experiment_label(row[\"experiment_label\"])\n",
        "\n",
        "    model_short = normalize_model(\n",
        "        row.get(\"model\", \"\"),\n",
        "        row.get(\"model_key\", \"\")\n",
        "    )\n",
        "\n",
        "    aug = normalize_augmentation(row.get(\"augmentation\", \"noaug\"))\n",
        "\n",
        "    if aug == \"noaug\":\n",
        "        return model_short\n",
        "\n",
        "    return compact_experiment_label(f\"{model_short}+{aug}\")\n",
        "\n",
        "\n",
        "def load_family_data(csv_path, family_name):\n",
        "    df = pd.read_csv(csv_path)\n",
        "\n",
        "    if \"fold\" not in df.columns:\n",
        "        raise ValueError(f\"The file does not contain a 'fold' column: {csv_path}\")\n",
        "\n",
        "    df[\"fold\"] = pd.to_numeric(df[\"fold\"], errors=\"coerce\")\n",
        "\n",
        "    for col in METRIC_COLS:\n",
        "        if col not in df.columns:\n",
        "            raise ValueError(f\"The file does not contain metric '{col}': {csv_path}\")\n",
        "\n",
        "        df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "\n",
        "    if family_name == \"ResNet3D-18\":\n",
        "        df[\"raw_experiment_label\"] = \"ResNet3D-18\"\n",
        "    else:\n",
        "        df[\"raw_experiment_label\"] = df.apply(create_experiment_label, axis=1)\n",
        "\n",
        "    df[\"family\"] = family_name\n",
        "\n",
        "    return df\n",
        "\n",
        "\n",
        "def select_best_experiment(df, family_name, metric_col):\n",
        "    ranking_df = (\n",
        "        df.groupby(\"raw_experiment_label\")[metric_col]\n",
        "        .agg([\"mean\", \"std\", \"median\", \"count\"])\n",
        "        .reset_index()\n",
        "    )\n",
        "\n",
        "    ranking_df = ranking_df.sort_values(\n",
        "        [\"mean\", \"median\"],\n",
        "        ascending=[False, False]\n",
        "    ).reset_index(drop=True)\n",
        "\n",
        "    best_experiment = ranking_df.iloc[0][\"raw_experiment_label\"]\n",
        "\n",
        "    selected_df = df[df[\"raw_experiment_label\"] == best_experiment].copy()\n",
        "    ranking_df[\"family\"] = family_name\n",
        "\n",
        "    return selected_df, ranking_df, best_experiment\n",
        "\n",
        "\n",
        "def build_display_label(family_name, best_experiment):\n",
        "    if family_name == \"ResNet3D-18\":\n",
        "        return \"ResNet3D-18\"\n",
        "\n",
        "    best_experiment = compact_experiment_label(best_experiment)\n",
        "\n",
        "    # New line helps readability on x-axis\n",
        "    return f\"{family_name}\\n{best_experiment}\"\n",
        "\n",
        "\n",
        "def paired_cohens_d(x, y):\n",
        "    diff = x - y\n",
        "    mean_diff = np.mean(diff)\n",
        "    std_diff = np.std(diff, ddof=1)\n",
        "\n",
        "    if std_diff == 0:\n",
        "        return np.nan, mean_diff, std_diff\n",
        "\n",
        "    d = mean_diff / std_diff\n",
        "    return d, mean_diff, std_diff\n",
        "\n",
        "\n",
        "def interpret_cohens_d(d):\n",
        "    if pd.isna(d):\n",
        "        return \"undefined\"\n",
        "\n",
        "    abs_d = abs(d)\n",
        "\n",
        "    if abs_d < 0.2:\n",
        "        return \"negligible\"\n",
        "    elif abs_d < 0.5:\n",
        "        return \"small\"\n",
        "    elif abs_d < 0.8:\n",
        "        return \"medium\"\n",
        "    else:\n",
        "        return \"large\"\n",
        "\n",
        "\n",
        "def add_bracket(ax, x1, x2, y, h, text):\n",
        "    ax.plot(\n",
        "        [x1, x1, x2, x2],\n",
        "        [y, y + h, y + h, y],\n",
        "        linewidth=1.5,\n",
        "        color=\"black\"\n",
        "    )\n",
        "\n",
        "    ax.text(\n",
        "        (x1 + x2) / 2,\n",
        "        y + h + 0.002,\n",
        "        text,\n",
        "        ha=\"center\",\n",
        "        va=\"bottom\",\n",
        "        fontsize=9,\n",
        "        fontweight=\"bold\"\n",
        "    )\n",
        "\n",
        "\n",
        "def build_paired_matrix(data, metric_col, order):\n",
        "    pivot_df = data.pivot_table(\n",
        "        index=\"fold\",\n",
        "        columns=\"display_label\",\n",
        "        values=metric_col,\n",
        "        aggfunc=\"mean\"\n",
        "    )\n",
        "\n",
        "    available_order = [\n",
        "        item for item in order\n",
        "        if item in pivot_df.columns\n",
        "    ]\n",
        "\n",
        "    pivot_df = pivot_df[available_order]\n",
        "    pivot_df = pivot_df.dropna(axis=0, how=\"any\")\n",
        "\n",
        "    return pivot_df\n",
        "\n",
        "\n",
        "def get_display_order(data, metric_col, manual_order):\n",
        "    if ORDER_MODE == \"manual\":\n",
        "        return manual_order\n",
        "\n",
        "    mean_scores = (\n",
        "        data.groupby(\"display_label\")[metric_col]\n",
        "        .mean()\n",
        "        .sort_values(ascending=False)\n",
        "    )\n",
        "\n",
        "    return mean_scores.index.tolist()\n",
        "\n",
        "\n",
        "def compute_pairwise_effects(pivot_df, metric_col, display_order):\n",
        "    effect_rows = []\n",
        "\n",
        "    for i in range(len(display_order)):\n",
        "        for j in range(i + 1, len(display_order)):\n",
        "            left_model = display_order[i]\n",
        "            right_model = display_order[j]\n",
        "\n",
        "            if left_model not in pivot_df.columns or right_model not in pivot_df.columns:\n",
        "                continue\n",
        "\n",
        "            left_values = pivot_df[left_model].values\n",
        "            right_values = pivot_df[right_model].values\n",
        "\n",
        "            d, mean_diff, std_diff = paired_cohens_d(\n",
        "                left_values,\n",
        "                right_values\n",
        "            )\n",
        "\n",
        "            try:\n",
        "                stat, p_value = wilcoxon(\n",
        "                    left_values,\n",
        "                    right_values,\n",
        "                    zero_method=\"wilcox\",\n",
        "                    alternative=\"two-sided\",\n",
        "                    mode=\"auto\"\n",
        "                )\n",
        "            except Exception:\n",
        "                stat = np.nan\n",
        "                p_value = np.nan\n",
        "\n",
        "            effect_rows.append({\n",
        "                \"metric\": metric_col,\n",
        "                \"left_model\": left_model,\n",
        "                \"right_model\": right_model,\n",
        "                \"left_mean\": np.mean(left_values),\n",
        "                \"right_mean\": np.mean(right_values),\n",
        "                \"mean_difference_left_minus_right\": mean_diff,\n",
        "                \"std_difference\": std_diff,\n",
        "                \"cohens_d_paired\": d,\n",
        "                \"effect_size_interpretation\": interpret_cohens_d(d),\n",
        "                \"wilcoxon_statistic\": stat,\n",
        "                \"wilcoxon_p_value\": p_value\n",
        "            })\n",
        "\n",
        "    return pd.DataFrame(effect_rows)\n",
        "\n",
        "\n",
        "def interpret_posthoc(row):\n",
        "    if row[\"reject_h0_holm\"]:\n",
        "        if row[\"mean_difference\"] > 0:\n",
        "            return f\"{row['baseline_best_model']} significantly better\"\n",
        "        elif row[\"mean_difference\"] < 0:\n",
        "            return f\"{row['comparison']} significantly better\"\n",
        "\n",
        "    return \"no significant difference\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
